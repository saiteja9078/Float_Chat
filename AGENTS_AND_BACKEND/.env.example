# Google Gemini API Keys
# Get your API keys from: https://makersuite.google.com/app/apikey

# Main Agent API Key (used for relevance checking, query decomposition, and decision making)
MAIN_AGENT_API_KEY=your_main_agent_api_key_here

# SQL Agent API Key (used for generating SQL queries)
SQL_AGENT_API_KEY=your_sql_agent_api_key_here

# Filter Agent API Key (used for filtering float IDs)
FILTER_AGENT_API_KEY=your_filter_agent_api_key_here
